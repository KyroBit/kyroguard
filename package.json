{
  "name": "@kyrobit/rbac",
  "version": "0.1.0",
  "description": "Scalable RBAC with policy groups, resource ownership and auto-scoped queries for Fastify + Drizzle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.js",
      "types":   "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "fastify": ">=5.0.0"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/node": "^26.1.0",
    "drizzle-orm": "^0.44.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "typescript": "^5.7.0"
  }
}
